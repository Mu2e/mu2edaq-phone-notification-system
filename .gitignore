# Presentation deliverables: node_modules is a symlink into a machine-local
# runtime cache, and scratch/{render,pptx-render,layout} are regenerated by
# src/build.mjs. scratch/assets holds the source images the deck embeds, so
# it stays tracked.
deliverables/*/node_modules/
deliverables/*/scratch/render/
deliverables/*/scratch/pptx-render/
deliverables/*/scratch/layout/
deliverables/*/scratch/logs/
deliverables/*/scratch/montage.png
